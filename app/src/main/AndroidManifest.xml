<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Real reachability check before every Gemini call (see net/Connectivity.kt). Normal permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Phase 2 — Tier 1 actions -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- No SEND_SMS: Google's enhanced fraud protection auto-denies it for sideloaded apps
         in some regions (India included). send_sms hands off to the Messages app via
         ACTION_SENDTO instead — no dangerous permission needed. -->
    <!-- Normal permission; lets the app appear in the DND-access list for ringer-mode changes -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- "Anywhere" trigger (floating bubble + Accessibility Button + foreground pipeline).
         SYSTEM_ALERT_WINDOW: draw the floating bubble over other apps — one-time special
         access, requested during setup. It also grants the background-activity-launch
         exemption the share flow needs when started from the bubble/button (see
         AccessibilityActions / AssistantService). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+: so the foreground-service notification for the bubble is visible. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Normal permission; lets BootReceiver re-raise the bubble after a reboot without her
         opening the app first. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ package visibility: so startActivity() for a call / an alarm resolves. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.CALL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <!-- so startActivity() for the send_sms hand-off to the Messages app resolves. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- TTS engine discovery + the one-time Hindi voice-data install screen. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
        </intent>
        <!-- Phase 3 share_onscreen: so getLaunchIntentForPackage() can bring the source
             app forward, and to keep WhatsApp visible. Instagram is validated; YouTube is
             being validated. -->
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.whatsapp" />
        <!-- search_and_open / switch_profile (Hotstar): grants visibility into every launchable
             app so Hotstar's package can be resolved by its launcher label instead of a
             hardcoded package id — no phone was connected this session to confirm via adb which
             package name the rebrand to JioHotstar left installed, so resolving
             dynamically avoids hardcoding a guess and self-corrects if it is renamed again. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- troubleshoot_app: the "update via Play Store" rung's market:// link. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- search_web / search_youtube: so startActivity() for the https search URL resolves. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Anywhere" trigger host: floating bubble + Accessibility Button + the shared
             voice pipeline running without MainActivity in the foreground. specialUse backs
             the persistent bubble; microphone is applied only while recording. -->
        <service
            android:name=".service.AssistantService"
            android:exported="false"
            android:foregroundServiceType="microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Always-available floating trigger for a single elderly user to start a voice command from any app" />
        </service>

        <!-- Phase 3 feature 1 — AccessibilityService that drives the on-screen share
             into WhatsApp (validated target: Instagram Reels). -->
        <service
            android:name=".service.AssistantAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Private, developer-only screen for the on-device debug log — reached only by a
             5-second long-press on the main screen's title (see MainActivity). Not exported,
             no intent-filter: never reachable except from within this app. -->
        <activity
            android:name=".debug.DebugLogActivity"
            android:exported="false"
            android:label="Debug Log" />

        <!-- Re-raises the bubble after a reboot if it was on before — see BootReceiver.kt. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
